@{
}
@model IEnumerable<CMS.Data.Entities.Post>

<div class="container mt-4">
    <h2 class="text-danger fw-bold text-uppercase mb-4">DANH SÁCH BÀI VIẾT MỚI NHẤT</h2>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail" style="height: 180px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/350x180?text=Thumbnail'">

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-primary fw-bold mb-2">@item.Title</h5>

                            <p class="card-text text-muted small flex-grow-1">@item.Content</p>

                            <p class="card-text text-secondary mb-3" style="font-size: 0.85rem;">
                                Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                            </p>

                            <div>
                                <a href="#" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <p class="text-center text-muted">Chưa có bài viết nào được đăng.</p>
            </div>
        }
    </div>
</div>