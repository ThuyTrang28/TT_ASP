@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <a asp-controller="Post" asp-action="Index" class="btn btn-secondary btn-sm mb-3">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>

            <h1 class="text-primary fw-bold mb-3">@Model.Title</h1>

            <p class="text-muted mb-4" style="font-size: 0.9rem;">
                <i class="bi bi-calendar3"></i> Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
            </p>

            <hr />

            <div class="text-center mb-4">
                <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Title" style="max-height: 400px; width: 100%; object-fit: cover;" onerror="this.src='https://via.placeholder.com/800x400?text=Post+Image'">
            </div>

            <div class="post-content lh-lg fs-5 text-justify" style="white-space: pre-line;">
                @Model.Content
            </div>
        </div>
    </div>
</div>