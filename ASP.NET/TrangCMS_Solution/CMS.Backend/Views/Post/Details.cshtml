@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <a asp-controller="Post" asp-action="Index" class="btn btn-secondary btn-sm mb-3 shadow-sm">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>

            <h1 class="text-primary fw-bold mb-3">@Model.Title</h1>

            <div class="d-flex gap-3 align-items-center text-muted mb-4" style="font-size: 0.95rem;">
                <span>
                    <i class="bi bi-calendar3"></i> Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy")
                </span>

                @if (Model.Category != null)
                {
                    <span class="badge bg-success text-white px-2.5 py-1.5 fw-semibold shadow-sm" style="font-size: 0.9rem;">
                        <i class="bi bi-folder-fill me-1"></i> Chuyên mục: @Model.Category.Name
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary text-white px-2.5 py-1.5" style="font-size: 0.9rem;">
                        <i class="bi bi-folder-x me-1"></i> Không rõ danh mục (ID: @Model.CategoryId)
                    </span>
                }
            </div>

            <hr />

            <div class="text-center mb-4">
                <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Title" style="max-height: 450px; width: 100%; object-fit: cover;" onerror="this.src='https://via.placeholder.com/800x450?text=No+Image+Available'">
            </div>

            <div class="post-content lh-lg fs-5 text-justify" style="white-space: pre-line; color: #2c3e50; text-align: justify;">
                @Model.Content
            </div>
        </div>
    </div>
</div>