@model IEnumerable<CMS.Data.Entities.User>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold text-uppercase m-0">QUẢN LÝ TÀI KHOẢN HỆ THỐNG</h2>
        <button class="btn btn-success btn-sm"><i class="bi bi-plus-lg"></i> Thêm người dùng</button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped m-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;" class="text-center">ID</th>
                        <th>Tên tài khoản</th>
                        <th>Họ và tên</th>
                        <th>Quyền hạn (Role)</th>
                        <th style="width: 200px;" class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold">@item.Id</td>
                                <td>@item.Username</td>
                                <td>@item.FullName</td>
                                <td>
                                    @if (item.Role == "Quản trị viên")
                                    {
                                        <span class="badge bg-danger">@item.Role</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">@item.Role</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="#" class="btn btn-warning btn-sm me-1">Sửa</a>
                                    <a href="#" class="btn btn-danger btn-sm">Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Chưa có người dùng nào trong hệ thống.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>