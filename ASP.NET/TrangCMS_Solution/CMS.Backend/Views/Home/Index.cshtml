@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Trang chủ - Tin tức mới nhất";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-danger text-uppercase position-relative d-inline-block pb-2" style="letter-spacing: 1px;">
            Tin Tức Mới Nhất
            <span class="position-absolute bottom-0 start-50 translate-middle-x bg-danger" style="width: 60px; height: 3px;"></span>
        </h2>
        <p class="text-muted mt-2">Cập nhật những bài viết và sự kiện nổi bật diễn ra trong ngày</p>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm h-100 border-0 rounded-3 overflow-hidden">

                        <div class="position-relative" style="height: 200px; background-color: #f8f9fa;">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="w-100 h-100 card-img-top" style="object-fit: cover;" alt="@item.Title" onerror="this.src='https://via.placeholder.com/400x200?text=No+Image+Available'">
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted font-monospace small bg-light border-bottom">
                                    <i class="bi bi-image me-1"></i> No Image Available
                                </div>
                            }
                        </div>

                        <div class="card-body d-flex flex-column">

                            <div class="mb-2">
                                @if (item.Category != null)
                                {
                                    <span class="badge bg-primary px-2.5 py-1.5 fw-semibold shadow-sm">
                                        <i class="bi bi-folder-fill me-1"></i> @item.Category.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-2.5 py-1.5 fw-semibold">
                                        <i class="bi bi-folder-x me-1"></i> Chưa phân loại
                                    </span>
                                }
                            </div>

                            <h5 class="card-title fw-bold text-dark text-truncate mb-2" title="@item.Title">@item.Title</h5>

                            <p class="card-text text-muted text-justify flex-grow-1 text-truncate" style="max-height: 48px; font-size: 0.9rem;">
                                @item.Content
                            </p>

                            <div class="mt-3">
                                <a href="/Post/Details/@item.Id" class="btn btn-outline-danger btn-sm fw-semibold w-100 py-2 shadow-sm">
                                    <i class="bi bi-book-half me-1"></i> Đọc tiếp
                                </a>
                            </div>
                        </div>

                        <div class="card-footer bg-transparent text-muted small border-top-0 py-3">
                            <i class="bi bi-calendar3 me-1"></i> Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted py-5">
                <i class="bi bi-newspaper fs-1 d-block mb-2 text-secondary"></i>
                Hệ thống chưa có bài viết nào được đăng tải.
            </div>
        }
    </div>
</div>