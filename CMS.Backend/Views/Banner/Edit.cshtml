@model CMS.Data.Entities.Banner

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa Banner";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-warning fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">Chỉnh sửa Banner</h2>
        <a asp-controller="Banner" asp-action="Index" class="btn btn-secondary btn-sm px-3 py-2 fw-semibold shadow-sm">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <form asp-controller="Banner" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Tiêu đề Banner</label>
                        <input asp-for="Title" class="form-control" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DisplayOrder" class="form-label fw-bold">Thứ tự hiển thị</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold">Chọn ảnh mới (Nếu muốn thay đổi)</label>
                        <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                        <small class="text-muted">Ảnh hiện tại: @Model.ImageUrl</small>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="TargetUrl" class="form-label fw-bold">Link đích (Target URL)</label>
                        <input asp-for="TargetUrl" class="form-control" placeholder="Để trống nếu không cần chuyển hướng..." />
                    </div>

                    <div class="col-md-12 mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label class="form-check-label fw-bold" asp-for="IsActive">Kích hoạt banner</label>
                        </div>
                    </div>
                </div>

                <div class="text-end border-top pt-3">
                    <button type="submit" class="btn btn-warning px-4 py-2 shadow-sm">
                        <i class="bi bi-check-circle"></i> Cập nhật thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}