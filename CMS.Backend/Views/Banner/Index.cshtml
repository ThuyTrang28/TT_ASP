@model IEnumerable<CMS.Data.Entities.Banner>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Banner";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">Quản Lý Banner Quảng Cáo</h2>
        <a asp-controller="Banner" asp-action="Create" class="btn btn-success btn-sm px-3 py-2 fw-semibold shadow-sm">
            <i class="bi bi-plus-lg"></i> Thêm banner mới
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-start border-danger border-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-start border-success border-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4" style="width: 10%;">Ảnh</th>
                        <th style="width: 25%;">Tiêu đề</th>
                        <th style="width: 20%;">Link đích</th>
                        <th class="text-center" style="width: 15%;">Thứ tự</th>
                        <th class="text-center" style="width: 10%;">Trạng thái</th>
                        <th class="text-center pe-4" style="width: 20%;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <img src="@item.ImageUrl" alt="Banner" class="rounded" style="width: 80px; height: 45px; object-fit: cover;">
                                </td>
                                <td class="fw-semibold">@item.Title</td>
                                <td class="text-muted text-truncate" style="max-width: 200px;">@item.TargetUrl</td>
                                <td class="text-center fw-bold">@item.DisplayOrder</td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Hiện</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ẩn</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <a asp-controller="Banner" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm me-1 font-monospace">Sửa</a>
                                    <a asp-controller="Banner" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm font-monospace" onclick="return confirm('Bạn có chắc chắn muốn xóa banner này?')">Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-3">Chưa có banner nào được tạo.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>