@model CMS.Data.Entities.Category

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-warning text-dark py-3">
            <h4 class="m-0 fw-bold text-uppercase" style="letter-spacing: 0.5px;">
                <i class="bi bi-pencil-square me-2"></i> Chỉnh Sửa Danh Mục
            </h4>
        </div>
        <div class="card-body p-4">

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary">Tên danh mục:</label>
                    <input asp-for="Name" class="form-control form-control-lg border-2" placeholder="Nhập tên danh mục mới..." required />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary">Mô tả chi tiết:</label>
                    <textarea asp-for="Description" class="form-control border-2" rows="4" placeholder="Nhập mô tả tóm tắt cho danh mục..."></textarea>
                </div>

                <div class="d-flex gap-2 justify-content-end border-top pt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-semibold">
                        <i class="bi bi-x-lg"></i> Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-warning px-4 fw-semibold text-dark shadow-sm">
                        <i class="bi bi-save-fill"></i> Cập nhật thay đổi
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>