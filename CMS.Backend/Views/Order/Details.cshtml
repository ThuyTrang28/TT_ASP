@model CMS.Data.Entities.Order

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">Chi tiết đơn hàng #@Model.Id</h2>
        <a asp-action="Index" class="btn btn-secondary btn-sm px-3 py-2 fw-semibold shadow-sm">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-dark text-white fw-bold">Thông tin khách hàng</div>
                <div class="card-body">
                    <p><strong>Họ tên:</strong> @Model.Customer?.FullName</p>
                    <p><strong>Email:</strong> @Model.Customer?.Email</p>
                    <p><strong>Số ĐT:</strong> @Model.Customer?.Phone</p>
                    <p><strong>Địa chỉ:</strong> @Model.Customer?.Address</p>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-dark text-white fw-bold">Danh sách sản phẩm</div>
                <div class="card-body p-0">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Sản phẩm</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end pe-4">Đơn giá</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                            {
                                @foreach (var item in Model.OrderDetails)
                                {
                                    <tr>
                                        <td class="ps-4">@item.Product?.Name</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end pe-4">@item.UnitPrice.ToString("N0") VNĐ</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted">Không có sản phẩm nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-end fw-bold">
                    Tổng cộng: @Model.OrderDetails?.Sum(x => x.Quantity * x.UnitPrice).ToString("N0") VNĐ
                </div>
            </div>
        </div>
    </div>
</div>