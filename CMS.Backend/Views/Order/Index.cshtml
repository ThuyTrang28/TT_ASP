@model IEnumerable<CMS.Data.Entities.Order>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">Quản Lý Đơn Hàng</h2>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-start border-danger border-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-start border-success border-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4" style="width: 12%;">Mã Đơn</th>
                        <th style="width: 25%;">Khách Hàng</th>
                        <th style="width: 23%;">Ngày Đặt</th>
                        <th style="width: 20%;">Trạng Thái</th>
                        <th class="text-center pe-4" style="width: 20%;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary font-monospace">#@item.Id</td>
                                <td class="fw-semibold text-dark">@(item.Customer != null ? item.Customer.FullName : "Khách vãng lai")</td>
                                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (item.Status == 0)
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-clock-history"></i> Chờ duyệt</span>
                                    }
                                    else if (item.Status == 1)
                                    {
                                        <span class="badge bg-primary px-2 py-1"><i class="bi bi-truck"></i> Đang giao</span>
                                    }
                                    else if (item.Status == 2)
                                    {
                                        <span class="badge bg-success px-2 py-1"><i class="bi bi-check-circle"></i> Đã xong</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1">Đã hủy</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm font-monospace">Xem đơn</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm font-monospace" onclick="return confirm('Bạn có chắc muốn xóa đơn hàng #@item.Id không?')">Xóa</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-receipt fs-2 d-block mb-2"></i> Chưa có đơn đặt hàng nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>