@model IEnumerable<CMS.Data.Entities.Order>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">Quản Lý Đơn Hàng</h2>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-start border-danger border-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-start border-success border-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4" style="width: 10%;">ID</th>
                        <th style="width: 25%;">Khách hàng</th>
                        <th style="width: 20%;">Ngày đặt</th>
                        <th style="width: 15%;">Thanh toán</th>
                        <th style="width: 22%;">Trạng thái</th>
                        <th class="text-center pe-4" style="width: 20%;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">@item.Id</td>
                                <td class="fw-semibold">@item.Customer?.FullName</td>
                                <td class="text-muted">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (item.PaymentMethod == "COD")
                                    {
                                        <span class="badge bg-warning text-dark">Chưa thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Đã thanh toán</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="UpdateStatus" method="post" class="d-flex">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <select name="status" class="form-select form-select-sm me-2" style="max-width: 150px;">
                                            <option value="0" selected="@(item.Status == 0)">Chờ duyệt</option>
                                            <option value="1" selected="@(item.Status == 1)">Đang giao</option>
                                            <option value="2" selected="@(item.Status == 2)">Đã xong</option>
                                            <option value="3" selected="@(item.Status == 3)">Đã hủy</option>
                                        </select>
                                        <button type="submit" class="btn btn-outline-success btn-sm">Lưu</button>
                                    </form>
                                </td>
                                <td class="text-center pe-4" style="white-space: nowrap;">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-outline-info btn-sm me-1">Chi tiết</a>

                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm"
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa đơn hàng này?')">Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">Chưa có đơn hàng nào được tìm thấy.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>