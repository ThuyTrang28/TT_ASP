@model CMS.Data.Entities.CategoryProduct

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết danh mục";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">Chi Tiết Danh Mục</h2>
        <a asp-controller="CategoryProduct" asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold shadow-sm">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-dark text-white fw-bold py-3">
                    <i class="bi bi-info-circle me-2"></i> Thông tin danh mục
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <small class="text-muted d-block text-uppercase fw-semibold mb-1">Mã danh mục</small>
                        <span class="fs-5 fw-bold text-secondary font-monospace">#@Model.Id</span>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted d-block text-uppercase fw-semibold mb-1">Tên danh mục</small>
                        <span class="fs-5 fw-bold text-primary">@Model.Name</span>
                    </div>

                    <div class="mb-4">
                        <small class="text-muted d-block text-uppercase fw-semibold mb-1">Mô tả chi tiết</small>
                        <p class="text-secondary lh-base mb-0" style="white-space: pre-line;">
                            @(string.IsNullOrEmpty(Model.Description) ? "Không có mô tả chi tiết cho danh mục này." : Model.Description)
                        </p>
                    </div>

                    <div class="border-top pt-3 d-grid">
                        <a asp-controller="CategoryProduct" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-semibold shadow-sm font-monospace">
                            <i class="bi bi-pencil-square"></i> Chỉnh sửa danh mục
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-success text-white fw-bold py-3 d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-box-seam me-2"></i> Sản phẩm thuộc danh mục</span>
                    <span class="badge bg-white text-success px-3 py-2 rounded-pill fw-bold">
                        @(Model.Products != null ? Model.Products.Count : 0) sản phẩm
                    </span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4" style="width: 15%;">Mã SP</th>
                                <th style="width: 45%;">Tên sản phẩm</th>
                                <th style="width: 25%;">Giá bán</th>
                                <th class="text-center pe-4" style="width: 15%;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Products != null && Model.Products.Any())
                            {
                                @foreach (var product in Model.Products)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-secondary font-monospace">#@product.Id</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                                {
                                                    <img src="@product.ImageUrl" alt="@product.Name" class="rounded me-2 shadow-sm border" style="width: 40px; height: 35px; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <div class="bg-light rounded me-2 d-flex align-items-center justify-content-center border" style="width: 40px; height: 35px;">
                                                        <i class="bi bi-image text-muted" style="font-size: 0.9rem;"></i>
                                                    </div>
                                                }
                                                <span class="fw-semibold text-dark">@product.Name</span>
                                            </div>
                                        </td>
                                        <td class="text-danger fw-bold">@product.Price.ToString("#,##0") đ</td>
                                        <td class="text-center pe-4">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-info btn-sm font-monospace" title="Xem chi tiết sản phẩm">
                                                Xem SP
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">
                                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                        Danh mục này hiện chưa có sản phẩm nào.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>