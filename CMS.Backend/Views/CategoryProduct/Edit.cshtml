@model CMS.Data.Entities.CategoryProduct

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">Chỉnh Sửa Danh Mục</h2>
        <a asp-controller="CategoryProduct" asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold shadow-sm">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <form asp-controller="CategoryProduct" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="row justify-content-center">
                    <div class="col-md-8">

                        <div class="p-3 bg-light rounded-3 mb-4 border-start border-warning border-4">
                            <small class="text-muted d-block text-uppercase fw-semibold">Mã danh mục đang chỉnh sửa</small>
                            <span class="text-secondary fw-bold font-monospace fs-5">#@Model.Id</span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold text-dark">Tên danh mục sản phẩm <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control form-control-lg fs-6" placeholder="Nhập tên danh mục sản phẩm..." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold text-dark">Mô tả chi tiết danh mục</label>
                            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Nhập mô tả chi tiết..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="border-top pt-3 mt-4 d-flex gap-2 justify-content-end">
                            <button type="submit" class="btn btn-warning px-4 fw-semibold shadow-sm font-monospace">
                                <i class="bi bi-check-circle"></i> Cập nhật danh mục
                            </button>
                            <a asp-controller="CategoryProduct" asp-action="Index" class="btn btn-light px-3 font-monospace border">Hủy bỏ</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}