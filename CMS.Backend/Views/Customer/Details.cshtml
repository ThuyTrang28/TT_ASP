@model CMS.Data.Entities.Customer

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết khách hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">Hồ Sơ Khách Hàng</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold shadow-sm">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <div class="row align-items-center mb-4 border-bottom pb-3">
                <div class="col-auto">
                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 70px; height: 70px;">
                        <i class="bi bi-person-fill fs-1"></i>
                    </div>
                </div>
                <div class="col">
                    <h3 class="fw-bold text-dark m-0">@Model.FullName</h3>
                    <p class="text-muted font-monospace m-0">Mã định danh khách hàng: #@Model.Id</p>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="p-3 border rounded bg-light shadow-none">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1"><i class="bi bi-envelope-at"></i> Địa chỉ Email</small>
                        <span class="text-dark fw-semibold">@Model.Email</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 border rounded bg-light shadow-none">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1"><i class="bi bi-telephone"></i> Số điện thoại</small>
                        <span class="text-dark fw-semibold">@(string.IsNullOrEmpty(Model.Phone) ? "Chưa cung cấp" : Model.Phone)</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 border rounded bg-light shadow-none">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1"><i class="bi bi-key"></i> Mật khẩu (Thô)</small>
                        <span class="font-monospace text-secondary">@Model.Password</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 border rounded bg-light shadow-none">
                        <small class="text-uppercase text-muted fw-bold d-block mb-1"><i class="bi bi-geo-alt"></i> Địa chỉ</small>
                        <span class="text-dark">@(string.IsNullOrEmpty(Model.Address) ? "Chưa cập nhật địa chỉ thường trú." : Model.Address)</span>
                    </div>
                </div>
            </div>

            <div class="border-top pt-3 mt-4 d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4 fw-semibold shadow-sm font-monospace">
                    <i class="bi bi-pencil-square"></i> Sửa thông tin
                </a>
            </div>
        </div>
    </div>
</div>