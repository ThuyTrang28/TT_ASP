@model CMS.Data.Entities.Customer

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm khách hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">Thêm Khách Hàng Mới</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold shadow-sm">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold">Họ và Tên <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="Nhập tên khách hàng..." />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold">Địa chỉ Email <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold">Số điện thoại</label>
                                <input asp-for="Phone" class="form-control" placeholder="Nhập SĐT..." />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold">Mật khẩu tài khoản <span class="text-danger">*</span></label>
                            <input asp-for="Password" type="password" class="form-control font-monospace" placeholder="Nhập mật khẩu thô..." />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Address" class="form-label fw-semibold">Địa chỉ thường trú</label>
                            <textarea asp-for="Address" class="form-control" rows="3" placeholder="Số nhà, tên đường, phường/xã, quận/huyện..."></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="border-top pt-3 d-flex gap-2 justify-content-end">
                            <button type="submit" class="btn btn-success px-4 fw-semibold shadow-sm font-monospace">
                                <i class="bi bi-save"></i> Lưu khách hàng
                            </button>
                            <a asp-action="Index" class="btn btn-light px-3 font-monospace border">Hủy bỏ</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}