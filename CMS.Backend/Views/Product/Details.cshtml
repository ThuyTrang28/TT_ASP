@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">Chi Tiết Sản Phẩm</h2>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold shadow-sm">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-5 text-center border-end-md mb-4 mb-md-0">
                    <div class="p-3 bg-light rounded-3 d-flex align-items-center justify-content-center" style="min-height: 350px;">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded-3 shadow-sm" style="max-height: 320px; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="text-stretch text-muted">
                                <i class="bi bi-image" style="font-size: 4rem;"></i>
                                <p class="mt-2 mb-0">Sản phẩm chưa có hình ảnh</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-7 ps-md-4">
                    <div class="mb-3">
                        <span class="badge bg-info text-dark fw-semibold px-3 py-2 fs-7">
                            <i class="bi bi-tag-fill me-1"></i> @(Model.CategoryProduct != null ? Model.CategoryProduct.Name : "Chưa phân loại")
                        </span>
                    </div>

                    <h1 class="h2 fw-bold text-dark mb-3">@Model.Name</h1>

                    <div class="p-3 bg-light rounded-3 mb-4 border-start border-danger border-4">
                        <small class="text-muted d-block text-uppercase fw-semibold">Giá bán hiện tại</small>
                        <span class="text-danger fw-bold fs-3">@Model.Price.ToString("#,##0") đ</span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-6 col-sm-4">
                            <div class="p-3 border rounded-3 bg-white text-center shadow-none">
                                <small class="text-muted d-block mb-1">Mã sản phẩm</small>
                                <span class="fw-bold text-secondary font-monospace">#@Model.Id</span>
                            </div>
                        </div>
                        <div class="col-6 col-sm-4">
                            <div class="p-3 border rounded-3 bg-white text-center shadow-none">
                                <small class="text-muted d-block mb-1">Trạng thái kho</small>
                                @if (Model.StockQuantity > 20)
                                {
                                    <span class="badge bg-success-subtle text-success fw-bold px-2 py-1">Còn hàng</span>
                                }
                                else if (Model.StockQuantity > 0)
                                {
                                    <span class="badge bg-warning-subtle text-warning fw-bold px-2 py-1">Sắp hết</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger fw-bold px-2 py-1">Hết hàng</span>
                                }
                            </div>
                        </div>
                        <div class="col-6 col-sm-4">
                            <div class="p-3 border rounded-3 bg-white text-center shadow-none">
                                <small class="text-muted d-block mb-1">Số lượng tồn</small>
                                <span class="fw-bold @(Model.StockQuantity <= 20 ? "text-warning" : "text-success")">@Model.StockQuantity</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5 class="fw-bold text-dark border-bottom pb-2"><i class="bi bi-file-text"></i> Mô tả sản phẩm</h5>
                        <div class="text-secondary lh-base" style="white-space: pre-line;">
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                @Model.Description
                            }
                            else
                            {
                                <span class="text-muted italic">Không có mô tả chi tiết cho sản phẩm này.</span>
                            }
                        </div>
                    </div>

                    <div class="border-top pt-3 d-flex gap-2">
                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4 py-2 fw-semibold shadow-sm font-monospace">
                            <i class="bi bi-pencil-square"></i> Chỉnh sửa
                        </a>
                        <a asp-controller="Product" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger px-4 py-2 font-monospace" onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?')">
                            Xóa sản phẩm
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>