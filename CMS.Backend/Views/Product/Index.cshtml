@model IEnumerable<CMS.Data.Entities.Product>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">Quản Lý Danh Sách Sản Phẩm</h2>
        <a asp-controller="Product" asp-action="Create" class="btn btn-success btn-sm px-3 py-2 fw-semibold shadow-sm">
            <i class="bi bi-plus-lg"></i> Thêm sản phẩm mới
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-start border-danger border-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-start border-success border-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4" style="width: 8%;">Mã ID</th>
                        <th style="width: 12%;">Hình Ảnh</th>
                        <th style="width: 25%;">Tên Sản Phẩm</th>
                        <th style="width: 15%;">Danh Mục</th>
                        <th style="width: 12%;">Giá Bán</th>
                        <th style="width: 10%;">Tồn Kho</th>
                        <th class="text-center pe-4" style="width: 18%;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">@item.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" class="img-thumbnail shadow-sm" style="width: 60px; height: 45px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Không ảnh</span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@item.Name</span>
                                    <p class="text-muted small text-truncate mb-0" style="max-width: 240px;" title="@item.Description">@item.Description</p>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark fw-semibold">
                                        @(item.CategoryProduct != null ? item.CategoryProduct.Name : "Chưa phân loại")
                                    </span>
                                </td>
                                <td class="text-start">
                                    @if (item.DiscountPercentage.HasValue && item.DiscountPercentage > 0)
                                    {
                                        <div class="text-danger fw-bold">@item.FinalPrice.ToString("#,##0") đ</div>
                                        <div class="small text-muted text-decoration-line-through">@item.Price.ToString("#,##0") đ</div>
                                        <span class="badge bg-danger" style="font-size: 0.65em;">-@item.DiscountPercentage%</span>
                                    }
                                    else if (item.DiscountAmount.HasValue && item.DiscountAmount > 0)
                                    {
                                        <div class="text-danger fw-bold">@item.FinalPrice.ToString("#,##0") đ</div>
                                        <div class="small text-muted text-decoration-line-through">@item.Price.ToString("#,##0") đ</div>
                                        <span class="badge bg-warning text-dark" style="font-size: 0.65em;">-@item.DiscountAmount.Value.ToString("#,##0")đ</span>
                                    }
                                    else
                                    {
                                        <div class="text-dark fw-bold">@item.Price.ToString("#,##0") đ</div>
                                    }
                                </td>
                                <td>
                                    @if (item.StockQuantity > 20)
                                    {
                                        <span class="text-success fw-bold">@item.StockQuantity</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning fw-bold" title="Số lượng tồn kho sắp hết!">@item.StockQuantity</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm me-1 font-monospace" title="Xem chi tiết sản phẩm">Xem</a>

                                    <a asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm me-1 font-monospace" title="Sửa sản phẩm">Sửa</a>

                                    <a asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm font-monospace" title="Xóa sản phẩm" onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?')">Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Chưa có dữ liệu sản phẩm nào được tìm thấy.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>